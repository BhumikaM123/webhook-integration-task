# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kyc_db?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Replace these placeholders with strong, unique secrets
KYC_WEBHOOK_SECRET="replace-with-a-long-random-webhook-secret"
JWT_SECRET="replace-with-a-long-random-jwt-secret"

# Optional application settings
PORT=3000
KYC_PROVIDER_NAME="identity-provider"
